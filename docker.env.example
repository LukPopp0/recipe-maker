# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Setup guide: docs/self-hosting.md. All app settings: docs/configuration.md.

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Public URL of the app, used to build image URLs
PUBLIC_BASE_URL=https://recipes.example.com

# Login is handled by tinyauth in front of the app; the app trusts the
# Remote-User header nginx forwards. Keep the app port bound to 127.0.0.1.
# AUTH_MODE=none (no login, everyone is the admin "local") is only for a
# trusted network without tinyauth; see docs/self-hosting.md.
AUTH_MODE=header
ADMIN_USERS=alice

# tinyauth (https://tinyauth.app/docs/reference/configuration)
# Users as username:bcrypt-hash, comma-separated. Keep the single quotes so
# the "$" signs in the hashes stay literal (do not double them to "$$").
# Adding users: docs/self-hosting.md, section Users.
TINYAUTH_APPURL=https://auth.recipes.example.com
TINYAUTH_AUTH_USERS=''
TINYAUTH_AUTH_SECURECOOKIE=true
